# Ignore all files and folders in root
/*

# Whitelist backend folder and root gitignore
!/backend/
!/.gitignore

# Backend ignores
backend/venv/
backend/env/
backend/.venv/
backend/.env
backend/*.env
!backend/.env.example
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/.pytest_cache/
backend/test_api.py
backend/check_db.py
backend/*.sqlite3
backend/*.db
backend/*.log

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
